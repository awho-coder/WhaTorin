{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WhaTorin",
  "mainBinaryName": "com.whatorin.cleanwrapper",
  "version": "0.1.0",
  "identifier": "com.whatorin.cleanwrapper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://web.whatsapp.com"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
